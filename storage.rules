rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Permitir la lectura pública de archivos (por ejemplo, imágenes de señales, logos, etc.)
      allow read: if true;
      
      // Solo permitir la escritura/subida de archivos a administradores autenticados
      allow write: if request.auth != null;
    }
  }
}
